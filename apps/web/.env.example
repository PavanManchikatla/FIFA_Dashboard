# Copy to .env.local and fill in to wire real services. Everything is optional —
# with none set, the app runs fully on in-process mocks (Phase 1 default).

# --- Cache (Upstash Redis REST). Unset → in-memory Map fallback. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Live source: worldcup26.ir. Unset → fixtures from mocks/. ---
WC26IR_BASE_URL=
# Set to 1 to make a mock match tick goals over time (demo the live beacon flip).
MOCK_LIVE_GOALS=

# --- API-Football (rich events). 100 req/day hard cap; event-driven only. ---
API_FOOTBALL_KEY=

# --- Map tiles. OpenFreeMap is keyless; these enable failover tiers. ---
# NEXT_PUBLIC_ → shipped client-side. Tile keys are domain-restricted, so this is OK.
NEXT_PUBLIC_STADIA_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
