# Copy to .env.local and fill in to wire real services. Everything is optional —
# with none set, the app runs fully on in-process mocks (Phase 1 default).

# --- Cache (Upstash Redis REST). Unset → in-memory Map fallback. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron auth. Set on Vercel so /api/cron/poll rejects non-cron callers. ---
# Vercel Cron auto-sends "Authorization: Bearer <CRON_SECRET>". Unset locally → route open.
CRON_SECRET=

# --- Live source: worldcup26.ir (JWT auth, v1.0.5). Unset → fixtures from mocks/. ---
WC26IR_BASE_URL=
# Register once (see docs/DEPLOY.md Step 1a), paste the token here. Valid ~84 days.
WC26IR_TOKEN=
# Used by the adapter's re-auth helper when the token 401s. Server-only — never prefix
# any of these with NEXT_PUBLIC_.
WC26IR_EMAIL=
WC26IR_PASSWORD=
# Set to 1 to make the opening mock match tick goals + go live (demo the beacon flip).
MOCK_LIVE_GOALS=

# --- API-Football (rich events). 100 req/day hard cap; event-driven only. ---
API_FOOTBALL_KEY=

# --- Live updates transport. Default (unset) = CDN-cached polling, the $0-scalable path on
#     Vercel Hobby. Set to 1 only on runtimes that sustain SSE connections cheaply. ---
NEXT_PUBLIC_ENABLE_SSE=

# --- Map tiles. OpenFreeMap is keyless; these enable failover tiers. ---
# NEXT_PUBLIC_ → shipped client-side. Tile keys are domain-restricted, so this is OK.
NEXT_PUBLIC_STADIA_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
